<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <location path="" overrideMode="Deny">
        <appSettings />
    </location>
    <system.webServer>
        <staticContent>
            <mimeMap fileExtension=".md" mimeType="text/plain" />
        </staticContent>
        <httpProtocol>
            <customHeaders>
            </customHeaders>
        </httpProtocol>
        <caching enabled="false" enableKernelCache="false" />
    </system.webServer>
</configuration>
